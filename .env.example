# Capella Model Service (AI Gateway) connection.
# Copy to .env and fill in. Never commit .env.
CMS_ENDPOINT=https://your-model-service-endpoint
CMS_API_KEY=
# Model name as listed by your Capella Model Service deployment (Claude Sonnet on Bedrock).
CMS_MODEL=anthropic.claude-sonnet-5-5

# Set to true to use the local mock gateway (no Capella access needed).
USE_MOCK=true
MOCK_PORT=8787

# Optional: send X-cb-debug: true to receive X-cb-match-score on semantic hits.
CMS_DEBUG=true
